{
  "type": "object",
  "properties": {
    "task": {
      "type": "string",
      "enum": [
        "review"
      ]
    },
    "manualToken": {
      "type": "string",
      "minLength": 4,
      "maxLength": 120,
      "description": "Manual lookup token; pass verbatim to slides_review_manual when you decide to revise this page."
    },
    "pageIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 23
    },
    "totalPages": {
      "type": "integer",
      "minimum": 1,
      "maximum": 24
    },
    "title": {
      "type": "string",
      "maxLength": 80
    },
    "role": {
      "type": "string",
      "maxLength": 24
    },
    "density": {
      "type": "string",
      "maxLength": 16
    },
    "layoutVersion": {
      "type": "integer",
      "enum": [
        2
      ]
    },
    "composition": {
      "type": "string",
      "maxLength": 24
    },
    "emphasis": {
      "type": "string",
      "maxLength": 16
    },
    "budget": {
      "type": "object",
      "properties": {
        "prose": {
          "type": "number"
        },
        "copy": {
          "type": "number"
        },
        "notes": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "styleTokens": {
      "type": "object",
      "additionalProperties": true,
      "description": "Deterministic deck style token snapshot resolved from the style card: composition/darkCover/motif/palette/typeScale/fonts/spacing/decoration/componentDefaults. Component styles must inherit it; per-node `style` only picks semantic enums (never raw hex/pt/px)."
    }
  },
  "required": [
    "task",
    "manualToken",
    "pageIndex",
    "totalPages"
  ],
  "additionalProperties": false
}