{
  "type": "object",
  "properties": {
    "task": {
      "type": "string",
      "enum": ["direction", "settle"],
      "description": "Which task this submission answers."
    },
    "imagePrompt": {
      "type": "string",
      "minLength": 40,
      "maxLength": 1200,
      "description": "direction: complete Chinese prompt for the overview image generation (structured layout spec with fake-text-bar rules)."
    },
    "styleBrief": {
      "type": "string",
      "maxLength": 500,
      "description": "direction: one-line style direction handed over to settle."
    },
    "styleParams": {
      "type": "object",
      "properties": {
        "palette": {
          "type": "object",
          "properties": {
            "background": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
            "surface": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
            "primary": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
            "accent": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
            "text": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
            "textMuted": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
            "onDarkText": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
            "chartSeries": {
              "type": "array",
              "minItems": 3,
              "maxItems": 6,
              "items": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
            }
          },
          "required": ["background", "surface", "primary", "accent", "text", "textMuted", "onDarkText", "chartSeries"],
          "additionalProperties": false
        },
        "typography": {
          "type": "object",
          "properties": {
            "fontHeading": { "type": "string" },
            "fontBody": { "type": "string" },
            "sizes": {
              "type": "object",
              "properties": {
                "coverTitle": { "type": "number", "minimum": 40, "maximum": 110 },
                "sectionTitle": { "type": "number", "minimum": 28, "maximum": 60 },
                "pageTitle": { "type": "number", "minimum": 20, "maximum": 40 },
                "subtitle": { "type": "number", "minimum": 14, "maximum": 24 },
                "body": { "type": "number", "minimum": 12, "maximum": 18 },
                "caption": { "type": "number", "minimum": 9, "maximum": 13 },
                "kpi": { "type": "number", "minimum": 28, "maximum": 90 },
                "table": { "type": "number", "minimum": 9, "maximum": 24 }
              },
              "required": ["coverTitle", "sectionTitle", "pageTitle", "subtitle", "body", "caption", "kpi", "table"],
              "additionalProperties": false
            },
            "headingBold": { "type": "boolean" }
          },
          "required": ["fontHeading", "fontBody", "sizes", "headingBold"],
          "additionalProperties": false
        },
        "spacing": {
          "type": "object",
          "properties": {
            "margin": { "type": "number", "minimum": 32, "maximum": 96 },
            "gutter": { "type": "number", "minimum": 8, "maximum": 40 },
            "cardPadding": { "type": "number", "minimum": 8, "maximum": 32 },
            "cornerRadius": { "type": "number", "minimum": 0, "maximum": 32 }
          },
          "required": ["margin", "gutter", "cardPadding", "cornerRadius"],
          "additionalProperties": false
        },
        "decoration": {
          "type": "object",
          "properties": {
            "cardStroke": { "type": ["string", "null"], "pattern": "^#[0-9a-fA-F]{6}$" },
            "cardStrokeWidthPt": { "type": "number", "minimum": 0.25, "maximum": 3 },
            "cardShadow": { "type": "string", "enum": ["none", "soft", "medium", "strong"] },
            "divider": { "type": "string", "enum": ["line", "none"] },
            "imageFit": { "type": "string", "enum": ["cover", "contain"] }
          },
          "required": ["cardStrokeWidthPt", "cardShadow", "divider", "imageFit"],
          "additionalProperties": false
        },
        "motif": {
          "type": "object",
          "properties": {
            "kind": { "type": "string", "enum": ["ghost-number", "ghost-word", "color-band", "corner-accent", "none"] },
            "spec": {
              "type": "object",
              "maxProperties": 6,
              "additionalProperties": { "type": ["string", "number"] }
            }
          },
          "required": ["kind", "spec"],
          "additionalProperties": false
        },
        "layoutHints": {
          "type": "object",
          "properties": {
            "cover": { "type": "string", "pattern": "^[PDTF]\\d[ab]?$" },
            "section": { "type": "string", "pattern": "^[PDTF]\\d[ab]?$" },
            "content": { "type": "string", "pattern": "^[PDTF]\\d[ab]?$" },
            "closing": { "type": "string", "pattern": "^[PDTF]\\d[ab]?$" }
          },
          "additionalProperties": false
        },
        "darkCover": { "type": "boolean" },
        "effectLines": {
          "type": "array",
          "minItems": 3,
          "maxItems": 10,
          "items": { "type": "string", "minLength": 2, "maxLength": 120 }
        }
      },
      "required": ["palette", "typography", "spacing", "decoration", "motif", "layoutHints", "darkCover", "effectLines"],
      "additionalProperties": false
    },
    "notes": {
      "type": "string",
      "maxLength": 1000,
      "description": "Reviewer notes for the orchestrator (what roles were adjusted and why)."
    }
  },
  "required": ["task"],
  "additionalProperties": false
}
